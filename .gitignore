# The user's global gitignore excludes *.csv. The gold results ARE the
# deliverable — detail tables alongside aggregates — so un-ignore them here.
# Repository .gitignore takes precedence over core.excludesFile.
!data/gold/results/**/*.csv
!data/gold/results/*.csv
!data/gold/results/**/*.csv.gz

# Excel lock files
~$*

# The global excludesFile also drops *.tiff. Publication figures ARE the
# deliverable, so un-ignore the figures tree (repo .gitignore takes precedence).
!figures/**/*.tiff
!figures/**/*.png
!data/bronze/concordances/*.csv
